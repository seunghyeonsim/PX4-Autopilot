#!/bin/sh
#
# @name GRIFFIN caged rolling drone (Gazebo)
#
# @type Quadrotor +
#
# Caged rolling quadrotor. The cage is fixed to the frame, so the whole vehicle
# rolls on the ground; rolling needs reverse thrust, hence the reversible
# motors (CA_R_REV).
#
# Everything the real vehicle shares with this one - geometry, rotor layout,
# propeller coefficients, height reference - lives in rc.griffin_defaults and
# is sourced below. Only what is genuinely simulation-specific stays here.
#

. ${R}etc/init.d/rc.mc_defaults
. ${R}etc/init.d/rc.griffin_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=griffin}

param set-default SIM_GZ_EN 1

param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_BAROSIM 0
param set-default SENS_EN_MAGSIM 1

# ------------------------------------------------------------ gz output map
# The real airframe replaces this whole block with PWM_MAIN_* or DShot.
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150

param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000

# Disarmed output. The default is 0, which for a reversible motor sits at the
# bottom of the [MIN, MAX] range and therefore means FULL REVERSE THRUST, not
# "off". Park it at the midpoint instead, which is zero thrust.
#   (150 + 1000) / 2 = 575
param set-default SIM_GZ_EC_DIS1 575
param set-default SIM_GZ_EC_DIS2 575
param set-default SIM_GZ_EC_DIS3 575
param set-default SIM_GZ_EC_DIS4 575

# Hover throttle is TUNED, not measured - it follows from what the motors,
# props and ESCs actually produce. Here it matches the simulated max_thrust of
# 4.5 N per rotor in GriffinThrustSystem. The real vehicle will have its own
# value, so this deliberately does NOT go in rc.griffin_defaults.
param set-default MPC_THR_HOVER 0.60
