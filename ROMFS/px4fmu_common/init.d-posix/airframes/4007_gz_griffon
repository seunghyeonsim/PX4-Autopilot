#!/bin/sh
#
# @name GRIFFON caged rolling drone (Gazebo)
#
# @type Quadrotor +
#
# Caged rolling quadrotor. The cage is fixed to the frame, so the whole vehicle
# rolls on the ground; rolling needs reverse thrust, hence the reversible
# motors (CA_R_REV).
#
# Rotor numbering follows the GRIFFON airframe drawing, not the PX4 default:
#
#   motor 1  right  (body -y in ROS/FLU, +y here in FRD)  CCW
#   motor 2  left                                          CCW
#   motor 3  FRONT                                         CW
#   motor 4  rear                                          CW
#
# Positions below are in the PX4 body frame (FRD: x forward, y right, z down).
# The GRIFFON URDF is REP-103 (FLU), so y and z are negated relative to
# griffon_params.xacro.
#
# Geometry source: Griffon_ws/src/griffon_description/urdf/griffon_params.xacro
#   arm      = 0.1125 m
#   rotor_z  = 0.005 m   (FLU, above centre)  ->  -0.005 in FRD
#
# WARNING: mass, inertia and the moment coefficient are still the placeholder
# values carried over from the old CAROLLINE airframe. Do not trust quantitative
# results until they are measured on GRIFFON.
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=griffon}

param set-default SIM_GZ_EN 1

param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_BAROSIM 0
param set-default SENS_EN_MAGSIM 1

# ---------------------------------------------------------------- allocation
param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# motor 1 — right, CCW  (KM > 0 is CCW in PX4)
param set-default CA_ROTOR0_PX 0.0
param set-default CA_ROTOR0_PY 0.1125
param set-default CA_ROTOR0_PZ -0.005
param set-default CA_ROTOR0_KM 0.05

# motor 2 — left, CCW
param set-default CA_ROTOR1_PX 0.0
param set-default CA_ROTOR1_PY -0.1125
param set-default CA_ROTOR1_PZ -0.005
param set-default CA_ROTOR1_KM 0.05

# motor 3 — front, CW
param set-default CA_ROTOR2_PX 0.1125
param set-default CA_ROTOR2_PY 0.0
param set-default CA_ROTOR2_PZ -0.005
param set-default CA_ROTOR2_KM -0.05

# motor 4 — rear, CW
param set-default CA_ROTOR3_PX -0.1125
param set-default CA_ROTOR3_PY 0.0
param set-default CA_ROTOR3_PZ -0.005
param set-default CA_ROTOR3_KM -0.05

# All four motors are bidirectional (bits 0-3). Rolling drives the cage with
# reverse thrust, which a stock unidirectional mixer cannot produce.
param set-default CA_R_REV 15

# ------------------------------------------------------------ gz output map
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150

param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000

# Disarmed output. The default is 0, which for a reversible motor sits at the
# bottom of the [MIN, MAX] range and therefore means FULL REVERSE THRUST, not
# "off". Park it at the midpoint instead, which is zero thrust.
#   (150 + 1000) / 2 = 575
param set-default SIM_GZ_EC_DIS1 575
param set-default SIM_GZ_EC_DIS2 575
param set-default SIM_GZ_EC_DIS3 575
param set-default SIM_GZ_EC_DIS4 575

param set-default MPC_THR_HOVER 0.60
