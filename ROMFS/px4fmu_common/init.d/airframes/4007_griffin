#!/bin/sh
#
# @name GRIFFIN caged rolling drone
#
# @type Quadrotor +
# @class Copter
#
# @maintainer Seunghyeon Sim
#
# Caged rolling quadrotor on a Pixhawk FMU-v6C with a Jetson companion.
#
# Everything this vehicle shares with the Gazebo one (4007_gz_griffin) -
# geometry, rotor layout, propeller coefficients, estimator source - lives in
# rc.griffin_defaults and is sourced below. Only what is genuinely
# hardware-specific stays here: output protocol, ESC pulse range, the
# companion link, and tuning.
#
# STATUS: written before the vehicle existed, never executed on a Pixhawk.
# SITL does NOT run this file (it is in the build, but only its @-header is
# parsed), so nothing here is verified until the board boots with it.
# First test: props off, QGC Actuators tab, check motor number and spin
# direction.
#

. ${R}etc/init.d/rc.mc_defaults
. ${R}etc/init.d/rc.griffin_defaults

# ---------------------------------------------------------------- outputs
# Motor numbering and directions are fixed by rc.griffin_defaults:
#   1 right CCW, 2 left CCW, 3 front CW, 4 rear CW.
# MAIN 1-4 all sit on TIM1, which is PWM_MAIN_TIM0 on this board.
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

# ------------------------------------------------- ESC block (phase 1)
# Phase 1 flies on stock UNIDIRECTIONAL ESCs: hover and flight only, no
# rolling. Everything in this block is about the ESC and changes together
# when the ESCs do; nothing outside it depends on them.
#
# No motor may reverse. This overrides nothing in rc.griffin_defaults - that
# file deliberately leaves CA_R_REV to the airframe. With a reversible
# mapping (CA_R_REV 15) on a unidirectional ESC, "zero thrust" would sit at
# the midpoint of the pulse range, i.e. half throttle the moment it arms.
param set-default CA_R_REV 0

# ESC: AIKON AK32 4-in-1 55 A, BLHeli_32 V3. Motors T-Motor F90 1500KV, 6040
# props, 6S.
#
# These are the values the frame actually FLEW with (without its cage) on the
# stock 5001 airframe, dumped from the Pixhawk on 2026-09-10 before flashing
# this fork (GRIFFIN/docs/pixhawk/params_2026-09-10_before_griffin.txt):
# plain PWM at 400 Hz, 1100..1900 us, 1000 us disarmed. Kept as flown. The
# rate/attitude gains in that dump were PX4 defaults, so nothing to carry.
#
# The ESC speaks DShot too. To switch later: PWM_MAIN_TIM0 -3 (DShot600),
# DSHOT_MIN 0.05, and drop the MIN/MAX/DIS lines. Re-test props off first.
param set-default PWM_MAIN_TIM0 400
param set-default PWM_MAIN_MIN1 1100
param set-default PWM_MAIN_MIN2 1100
param set-default PWM_MAIN_MIN3 1100
param set-default PWM_MAIN_MIN4 1100
param set-default PWM_MAIN_MAX1 1900
param set-default PWM_MAIN_MAX2 1900
param set-default PWM_MAIN_MAX3 1900
param set-default PWM_MAIN_MAX4 1900
param set-default PWM_MAIN_DIS1 1000
param set-default PWM_MAIN_DIS2 1000
param set-default PWM_MAIN_DIS3 1000
param set-default PWM_MAIN_DIS4 1000

# ---- phase 2, bidirectional ESCs (rolling). Not active. Replace the lines
# above with these once the ESCs are chosen and CONFIRMED to reverse.
# PX4 puts zero thrust for a reversible motor at the MIDPOINT of [MIN, MAX],
# so MIN/MAX must be symmetric about the ESC's neutral pulse, and DISARMED
# and FAILSAFE must be that neutral - the default 1000 would be full reverse.
# CAROLLINE's BLHeli_32 "Bidirectional Soft" ESCs were 1040 / 1500 / 1960.
#   param set-default CA_R_REV 15
#   param set-default PWM_MAIN_TIM0 400
#   param set-default PWM_MAIN_MIN1 1040   (x4)
#   param set-default PWM_MAIN_MAX1 1960   (x4)
#   param set-default PWM_MAIN_DIS1 1500   (x4)
#   param set-default PWM_MAIN_FAIL1 1500  (x4)
# DShot 3D instead: PWM_MAIN_TIM0 -3, DSHOT_3D_ENABLE 1, DSHOT_MIN 0, and no
# MIN/MAX/DIS/FAIL lines - DShot 3D splits the range itself.
# ------------------------------------------------- end of ESC block

# ------------------------------------------------- flown setup, carried over
# Selecting a new airframe makes PX4 reset every parameter except RC*,
# COM_FLTMODE*, accel/gyro calibration and a few counters. What the flown
# configuration relied on beyond those is restated here:
param set-default BAT1_N_CELLS 6
param set-default COM_ARM_WO_GPS 1        # there is no GPS on this vehicle
param set-default COM_RC_IN_MODE 3
# The flown setup also had the safety-switch and USB-connected arming checks
# disabled (CBRK_IO_SAFETY, CBRK_USB_CHK) and the supply check off
# (CBRK_SUPPLY_CHK). Those are deliberately NOT set here - set them by hand in
# QGC if the bench test needs them. Magnetometer calibration (CAL_MAG*) is not
# preserved either; redo it in QGC.

# ---------------------------------------------------------------- companion
# Jetson on TELEM2 (/dev/ttyS3 on this board) over uXRCE-DDS. Agent side:
#   MicroXRCEAgent serial --dev /dev/ttyTHS1 -b 921600
#
# The DDS domain must equal ROS_DOMAIN_ID (42 on both machines). SITL gets
# this for free - rcS copies the environment variable into the parameter -
# but a Pixhawk has no environment, so it is set here. With the default 0 the
# /fmu/* topics never appear in ROS 2 and nothing reports an error.
param set-default UXRCE_DDS_CFG 102
param set-default SER_TEL2_BAUD 921600
param set-default UXRCE_DDS_DOM_ID 42

# ---------------------------------------------------------------- tuning
# Hover throttle is TUNED, not measured. The simulation's 0.60 belongs to the
# 4.5 N simulated rotor; the real value comes from the thrust stand and the
# first tethered hover. Left at the PX4 default until then, on purpose.
# param set-default MPC_THR_HOVER 0.5
